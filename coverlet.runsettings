<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Межа вимірювання: домен і прикладний шар. Поза межами: інфраструктура та Legacy. -->
          <ExcludeByFile>**/Infrastructure/**/*.cs,**/Storage/**/*.cs,**/Auditing/**/*.cs,**/Legacy/**/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
